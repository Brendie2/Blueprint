{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Keep the same "name" as your existing Worker so this updates it instead of creating a new one
  "name": "market-perception-build",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "BREVO_LIST_ID": "REPLACE_WITH_LIST_ID",
    "NOTIFY_EMAIL": "REPLACE_WITH_YOUR_EMAIL",
    "SENDER_EMAIL": "REPLACE_WITH_BREVO_VERIFIED_SENDER",
    "SENDER_NAME": "Brenda Blanche",
    "ALLOWED_ORIGIN": "https://blueprint.brendablanche.site"
  }
}
