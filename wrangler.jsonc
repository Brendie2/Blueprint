
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blueprint",
  "main": "src/index.js",
  "compatibility_date": "2026-10-10",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]

  // ...
  "vars": {
    "BREVO_LIST_ID": "2",
    "NOTIFY_EMAIL": "unapologeticquenn@gmail.com",
    "RESEND_FROM": "Brenda Blanche <notifications@mail.brendablanche.site>"
  },
  // ...

  }
}
